# GovFlow local development settings

DB_HOST=localhost
DB_PORT=5432
DB_USER=govflow
DB_PASSWORD=replace_with_a_strong_database_password
DB_NAME=govflow
DATABASE_URL=postgresql://govflow:change_me_dev_database_password@localhost:5432/govflow?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace_with_a_strong_redis_password

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=govflow-files
MINIO_ACCESS_KEY=replace_with_a_minio_access_key
MINIO_SECRET_KEY=replace_with_a_strong_minio_secret_key

GOVFLOW_MAX_UPLOAD_BYTES=10485760
CLAMAV_ENABLED=false
# Use "clamav" when the API runs inside the Docker Compose network.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=5000

JWT_SECRET=replace_with_a_random_64_character_secret_for_access_tokens
JWT_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_random_64_character_secret_for_refresh_tokens
JWT_REFRESH_EXPIRY=8h
CSRF_SECRET=replace_with_a_random_64_character_secret_for_csrf_tokens

API_PORT=3001
WEB_PORT=5173
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

SEED_ADMIN_EMAIL=admin@govflow.gov.np
SEED_ADMIN_PASSWORD=replace_with_a_temporary_strong_admin_password
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Administrator

SEED_ORG_NAME=Government of Nepal
SEED_DEPT_NAME=Public Works Department
SEED_BRANCH_NAME=Head Office
